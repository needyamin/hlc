{
  "schema_version": 2,
  "runtime_environment": "windows",
  "target_url": "http://localhost:18091/",
  "mode": "direct",
  "profile": "standard",
  "health_path": "/health",
  "paths": [
    {
      "path": "/",
      "weight": 30
    },
    {
      "path": "/health",
      "weight": 20
    },
    {
      "path": "/catalog",
      "weight": 25
    },
    {
      "path": "/cart",
      "weight": 25
