  "keep_alive": true,
  "sample_period_s": 1.0,
  "cooldown_s": 60,
  "reprobe_s": 15,
  "phases": [
    {
      "name": "01-plateau",
      "label": "Idle plateau (C=0)",
      "duration_s": 120,
      "probe_hz": 0.0,
      "role": "idle",
      "concurrency": 0
    },
    {
      "name": "02-warmup",
      "label": "Warm-up (C=5)",
      "duration_s": 30,
      "probe_hz": 1.0,
      "role": "active",
      "concurrency": 5
    },
    {
      "name": "03-ramp",
      "label": "Ramp 5-10-25-50-100",
      "duration_s": 100,
      "probe_hz": 1.0,
      "role": "active",
      "steps": [
        5,
        10,
        25,
        50,
        100
      ],
      "concurrency": 100
    },
    {
      "name": "04-sustained",
      "label": "Sustained heavy (C=100)",
      "duration_s": 180,
      "probe_hz": 1.0,
      "role": "sustained",
      "concurrency": 100
    },
    {
      "name": "05-spike",
      "label": "Spike / break point (C=200-300)",
      "duration_s": 45,
      "probe_hz": 1.0,
      "role": "spike",
      "steps": [
        200,
        300
      ],
      "concurrency": 300
    },
    {
      "name": "06-soak",
      "label": "Endurance soak (C=50)",
      "duration_s": 300,
      "probe_hz": 1.0,
      "role": "soak",
      "concurrency": 50
    },
    {
      "name": "07-zero-load",
      "label": "Zero-load recovery (C=0)",
      "duration_s": 600,
      "probe_hz": 0.0,
      "role": "cooldown",
      "concurrency": 0
    },
    {
      "name": "08-reprobe",
      "label": "Availability re-probe",
      "duration_s": 60,
      "probe_hz": 1.0,
      "role": "reprobe",
      "concurrency": 0
    }
  ],
  "benchmark_mode": "live_blackbox",
  "target": {
    "site_id": "spid3r-http",
    "group": "hlc-http",
