import "http";

fn get_port(dflt) {
    let p = env("HLC_PORT");
    if p.is_some() {
        let v = p.unwrap();
        if v != "" {
            return v;
        }
    }
    return dflt;
}

fn main() {
    let port = get_port("18091");
    let app = new HttpServer();
    app.logging = false;
    app.opts = map(
        "access_log", false,
        "watch_signals", false,
        "max_requests_per_conn", 10000,
        "idle_timeout_ms", 30000,
        "timeout_ms", 30000,
        "workers", 4
    );
    app.get("/", fn(req) {
        return http_json(200, map("ok", true, "service", "spid3r-hlc", "routes", ["/", "/health", "/catalog", "/cart"]));
    });
    app.get("/health", fn(req) {
        return http_json(200, map("status", "ok"));
    });
    app.get("/catalog", fn(req) {
        return http_json(200, map("items", [
            map("id", 1, "name", "Widget", "price", 1999),
            map("id", 2, "name", "Gadget", "price", 3499),
            map("id", 3, "name", "Doohickey", "price", 999)
        ]));
    });
    app.get("/cart", fn(req) {
        return http_json(200, map("items", [map("id", 1, "qty", 2)], "subtotal", 3998, "currency", "USD"));
    });
    app.bind("127.0.0.1:" + port);
    app.serve(-1);
    return 0;
}
